# ---------- LLM (provider-agnostic via LangChain init_chat_model) ----------
# Default: Anthropic Claude
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=

# Alternative: OpenAI
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=
# (also run: pip install langchain-openai)

# Alternative: local Ollama (no key, runs on your laptop)
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1
# (also run: pip install langchain-ollama, and `ollama pull llama3.1`)

# ---------- Database ----------
# Leave empty to use the SQLite fallback at artifacts/vardhan.db
# Postgres (admin URL, used only by the migration):
# DATABASE_URL=postgresql+psycopg://vardhan:vardhan@localhost:5432/vardhan
# Postgres (read-only agent role created by the migration):
# AGENT_DATABASE_URL=postgresql+psycopg://copilot_agent:change-me@localhost:5432/vardhan
AGENT_DB_PASSWORD=change-me

# ---------- Gmail / Calendar ----------
# mock = local JSON inbox + calendar (no Google account needed)
# real = Google APIs, needs credentials.json in the project folder
GOOGLE_MODE=mock

# ---------- Embeddings ----------
# local = BAAI/bge-small-en-v1.5 on your machine (default, free, offline after first download)
# openai = text-embedding-3-small (needs OPENAI_API_KEY and pip install langchain-openai)
EMBEDDINGS=local
